{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Watch assets",
      "type": "process",
      "command": "node",
      "args": [
        "scripts/build-assets.mjs",
        "watch"
      ],
      "isBackground": true,
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": [
        {
          "pattern": [
            {
              "regexp": "."
            }
          ],
          "background": {
            "activeOnStart": true,
            "beginsPattern": "Assets minificados:",
            "endsPattern": "\\[watch\\] Observando cambios en assets\\. Pulsa Ctrl\\+C para salir\\."
          }
        }
      ],
      "presentation": {
        "reveal": "never",
        "panel": "dedicated",
        "clear": false
      }
    },
    {
      "label": "Build assets",
      "type": "process",
      "command": "node",
      "args": [
        "scripts/build-assets.mjs",
        "build"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
